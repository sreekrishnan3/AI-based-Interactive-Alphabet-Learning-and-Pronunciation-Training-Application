  });

  @override
  Widget build(BuildContext context) {
    final bool passed = correct > 3 && wrong < 2;

    return Scaffold(
      body: Stack(
        fit: StackFit.expand,
        children: [
          Image.asset('assets/page/score.jpg', fit: BoxFit.cover),

          Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
