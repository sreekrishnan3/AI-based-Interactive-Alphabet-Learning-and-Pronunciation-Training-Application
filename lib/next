class FinalGamePage extends StatefulWidget {
  const FinalGamePage({super.key});

  @override
  State<FinalGamePage> createState() => _FinalGamePageState();
}

class _FinalGamePageState extends State<FinalGamePage>
    with TickerProviderStateMixin {
  late VideoPlayerController _videoController;
  late AnimationController _scrollController;
  late AnimationController _floatController;
  late AnimationController _shakeController;
  late AnimationController _dropController;

  late Animation<double> _floatAnim;
  late Animation<double> _shakeAnim;
  late Animation<double> _dropAnim;

  final List<String> allLetters =
      List.generate(26, (i) => String.fromCharCode(65 + i));

  late List<String> objectQueue;
  List<String> movingLetters = [];

  int currentIndex = 0;
  String? droppingLetter;

  @override
  void initState() {
    super.initState();

    /// 🎥 Background Video
    _videoController =
        VideoPlayerController.asset('assets/video/train.mp4')
          ..initialize().then((_) {
            if (mounted) {
              setState(() {});
              _videoController
                ..setLooping(true)
                ..play();
            }
          });

    objectQueue = List.from(allLetters)..shuffle();
    _generateMovingLetters();

    /// Slow continuous movement (RIGHT ➜ LEFT)
    _scrollController =
        AnimationController(vsync: this, duration: const Duration(seconds: 20))
          ..repeat();

    /// Floating animation
    _floatController =
        AnimationController(vsync: this, duration: const Duration(seconds: 2))
          ..repeat(reverse: true);

    _floatAnim = Tween(begin: -10.0, end: 10.0).animate(
        CurvedAnimation(parent: _floatController, curve: Curves.easeInOut));

    /// Shake object
    _shakeController =
        AnimationController(vsync: this, duration: const Duration(milliseconds: 500))
          ..repeat(reverse: true);

    _shakeAnim = Tween(begin: -4.0, end: 4.0).animate(
        CurvedAnimation(parent: _shakeController, curve: Curves.easeInOut));

    /// Drop animation
    _dropController =
        AnimationController(vsync: this, duration: const Duration(milliseconds: 800));

    _dropAnim = Tween(begin: 0.0, end: 320.0).animate(
        CurvedAnimation(parent: _dropController, curve: Curves.easeIn));
  }

  void _generateMovingLetters() {
    String correct = objectQueue[currentIndex];

    // Repeat correct letter 2–3 times
    int repeatCount = 2 + (DateTime.now().millisecond % 2);

    movingLetters.clear();

    for (int i = 0; i < repeatCount; i++) {
      movingLetters.add(correct);
    }

    // Add random other letters to make total 4
    final others = List<String>.from(allLetters)..shuffle();

    for (String l in others) {
      if (l != correct && movingLetters.length < 4) {
        movingLetters.add(l);
      }
    }

    movingLetters.shuffle();
  }

  void _onLetterTap(String letter) {
    if (letter == objectQueue[currentIndex]) {
      setState(() {
        droppingLetter = letter;
      });

      _dropController.forward(from: 0);

      Future.delayed(const Duration(milliseconds: 900), () {
        if (!mounted) return;

        setState(() {
          droppingLetter = null;
          currentIndex++;
          if (currentIndex >= objectQueue.length) {
            currentIndex = 0;
            objectQueue.shuffle();
          }
          _generateMovingLetters();
        });
      });
    }
  }

  @override
  void dispose() {
    _videoController.dispose();
    _scrollController.dispose();
    _floatController.dispose();
    _shakeController.dispose();
    _dropController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    if (!_videoController.value.isInitialized) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator()),
      );
    }

    final size = MediaQuery.of(context).size;

    return Scaffold(
      body: Stack(
        children: [
          /// 🎥 Background
          SizedBox.expand(
            child: FittedBox(
              fit: BoxFit.cover,
              child: SizedBox(
                width: _videoController.value.size.width,
                height: _videoController.value.size.height,
                child: VideoPlayer(_videoController),
              ),
            ),
          ),

          /// 🔤 Moving Alphabets (RIGHT ➜ LEFT)
          Positioned(
            top: 90,
            child: AnimatedBuilder(
              animation: _scrollController,
              builder: (_, __) {
                return Transform.translate(
                  offset: Offset(
                      size.width - (_scrollController.value * (size.width + 400)),
                      0),
                  child: Row(
                    children: movingLetters.map((l) {
                      return AnimatedBuilder(
                        animation: _floatAnim,
                        builder: (_, child) {
                          return Transform.translate(
                            offset: Offset(0, _floatAnim.value),
                            child: child,
                          );
                        },
                        child: GestureDetector(
                          onTap: () => _onLetterTap(l),
                          child: Padding(
                            padding:
                                const EdgeInsets.symmetric(horizontal: 40),
                            child: Image.asset(
                              'assets/alphabets/$l.png',
                              height: 90,
                            ),
                          ),
                        ),
                      );
                    }).toList(),
                  ),
                );
              },
            ),
          ),

          /// 🧸 Object Image
          Positioned(
            bottom: 160,
            left: 0,
            right: 0,
            child: Center(
              child: AnimatedBuilder(
                animation: _shakeAnim,
                builder: (_, child) {
                  return Transform.translate(
                    offset: Offset(_shakeAnim.value, 0),
                    child: child,
                  );
                },
                child: Image.asset(
                  'assets/images/img${objectQueue[currentIndex]}.png',
                  height: 120,
                ),
              ),
            ),
          ),

          /// ⬇ Drop Animation
          if (droppingLetter != null)
            Positioned(
              top: 90,
              left: size.width / 2 - 45,
              child: AnimatedBuilder(
                animation: _dropAnim,
                builder: (_, child) {
                  return Transform.translate(
                    offset: Offset(0, _dropAnim.value),
                    child: child,
                  );
                },
                child: Image.asset(
                  'assets/alphabets/$droppingLetter.png',
                  height: 90,
                ),
              ),
            ),
        ],
      ),
    );
  }
}


