/// ================= OBJECT BASKET ASSESSMENT ================= ///

class ObjectBasketAssessmentPage extends StatefulWidget {
  final String start, end;

  const ObjectBasketAssessmentPage({
    super.key,
    required this.start,
    required this.end,
  });

  @override
  State<ObjectBasketAssessmentPage> createState() =>
      _ObjectBasketAssessmentPageState();
}

class _ObjectBasketAssessmentPageState
    extends State<ObjectBasketAssessmentPage>
    with SingleTickerProviderStateMixin {

  late final List<String> letters;
  late final List<String> objects;

  int index = 0;
  bool finished = false;

  String? glowingBasket;
  String? shakingBasket;

  late AnimationController _shakeCtrl;
  late Animation<double> _shakeAnim;

  /// 🔊 AUDIO PLAYER
  final AudioPlayer _soundPlayer = AudioPlayer();

  @override
  void initState() {
    super.initState();

    /// Generate letters
    letters = List.generate(
      widget.end.codeUnitAt(0) - widget.start.codeUnitAt(0) + 1,
      (i) => String.fromCharCode(widget.start.codeUnitAt(0) + i),
    );

    /// Shuffle objects
    objects = List.from(letters)..shuffle();

    /// Shake animation
    _shakeCtrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 350),
    );

    _shakeAnim = Tween<double>(begin: -6, end: 6).animate(
      CurvedAnimation(
        parent: _shakeCtrl,
        curve: Curves.elasticIn,
      ),
    );
  }

  @override
  void dispose() {
    _shakeCtrl.dispose();
    _soundPlayer.dispose();
    super.dispose();
  }

  /// ✅ Correct Sound
  Future<void> _playCorrectSound() async {
    await _soundPlayer.stop();
    await _soundPlayer.play(
      AssetSource('music/correct.mp3'),
    );
  }

  /// ❌ Wrong Sound
  Future<void> _playWrongSound() async {
    await _soundPlayer.stop();
    await _soundPlayer.play(
      AssetSource('music/wrong.mp3'),
    );
  }

  /// ✅ Finish Assessment
  void _finish() {

    if (finished || !mounted) return;

    finished = true;

    /// Unlock levels
    if (widget.start == 'A') {
      level2Unlocked = true;
    } else if (widget.start == 'F') {
      level3Unlocked = true;
    } else if (widget.start == 'K') {
      level4Unlocked = true;
    } else if (widget.start == 'P') {
      level5Unlocked = true;
    }

    Navigator.pushAndRemoveUntil(
      context,
      MaterialPageRoute(
        builder: (_) => const LevelPage(),
      ),
      (_) => false,
    );
  }

  /// 🎯 Drop Logic
  void _onDrop(String dragged, String target) {

    if (dragged == target) {

      /// ✅ Correct Match
      _playCorrectSound();

      setState(() {
        glowingBasket = target;
      });

      Future.delayed(const Duration(milliseconds: 500), () {

        if (!mounted) return;

        setState(() {
          glowingBasket = null;
          index++;
        });

        if (index >= objects.length) {
          _finish();
        }
      });

    } else {

      /// ❌ Wrong Match
      _playWrongSound();

      setState(() {
        shakingBasket = target;
      });

      _shakeCtrl.forward(from: 0);

      Future.delayed(const Duration(milliseconds: 400), () {

        if (!mounted) return;

        setState(() {
          shakingBasket = null;
        });
      });
    }
  }

  @override
  Widget build(BuildContext context) {

    if (index >= objects.length) {
      return const SizedBox();
    }

    final size = MediaQuery.of(context).size;

    final topPadding =
        MediaQuery.of(context).padding.top + kToolbarHeight;

    final current = objects[index];

    return Scaffold(

      extendBodyBehindAppBar: true,

      appBar: AppBar(
        title: const Text('Object Basket Assessment'),
        centerTitle: true,
        backgroundColor: Colors.transparent,
        elevation: 0,

        leading: IconButton(
          icon: const Icon(Icons.arrow_back),
          onPressed: () => Navigator.pop(context),
        ),
      ),

      body: Stack(
        fit: StackFit.expand,
        children: [

          /// 🌄 BACKGROUND
          Image.asset(
            'assets/page/basket.png',
            fit: BoxFit.cover,
          ),

          Padding(
            padding: EdgeInsets.only(top: topPadding),

            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [

                /// ================= DRAGGABLE OBJECT =================

                Draggable<String>(

                  data: current,

                  feedback: Material(
                    color: Colors.transparent,
                    child: Image.asset(
                      'assets/images/img$current.png',
                      height: size.height * 0.25,
                    ),
                  ),

                  childWhenDragging: SizedBox(
                    height: size.height * 0.25,
                  ),

                  child: Image.asset(
                    'assets/images/img$current.png',
                    height: size.height * 0.25,
                  ),
                ),

                const SizedBox(height: 40),

                /// ================= BASKETS =================

                Wrap(
                  spacing: 25,
                  runSpacing: 25,
                  alignment: WrapAlignment.center,

                  children: letters.map((l) {

                    final glow = glowingBasket == l;
                    final shake = shakingBasket == l;

                    return DragTarget<String>(

                      onAcceptWithDetails: (details) {
                        _onDrop(details.data, l);
                      },

                      builder: (_, __, ___) {

                        return AnimatedBuilder(

                          animation: _shakeAnim,

                          builder: (_, child) {

                            return Transform.translate(

                              offset: Offset(
                                shake ? _shakeAnim.value : 0,
                                0,
                              ),

                              child: Container(

                                decoration: BoxDecoration(

                                  boxShadow: glow
                                      ? [
                                          const BoxShadow(
                                            color: Colors.yellow,
                                            blurRadius: 20,
                                            spreadRadius: 6,
                                          )
                                        ]
                                      : [],
                                ),

                                child: child,
                              ),
                            );
                          },

                          child: Image.asset(
                            'assets/basket/b$l.png',
                            height: size.height * 0.30,
                          ),
                        );
                      },
                    );
                  }).toList(),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}



/// ================= AI PRONUNCIATION TRAINER ================= ///

class AIPronunciationPage extends StatefulWidget {
  const AIPronunciationPage({super.key});

  @override
  State<AIPronunciationPage> createState() => _AIPronunciationPageState();
}

class _AIPronunciationPageState extends State<AIPronunciationPage> {

  late stt.SpeechToText speech;
  bool listening = false;

  String spokenText = "";
  String currentLetter = "A";

  @override
  void initState() {
    super.initState();
    speech = stt.SpeechToText();
  }

  void startListening() async {

    bool available = await speech.initialize();

    if (available) {

      setState(() {
        listening = true;
      });

      speech.listen(
        onResult: (result) {

          setState(() {
            spokenText = result.recognizedWords.toLowerCase();
          });

          String correctWord =
              objectNames[currentLetter]!.toLowerCase();

          if (spokenText.contains(correctWord)) {
            _showResult(true);
          } else {
            _showResult(false);
          }
        },
      );
    }
  }

  void stopListening() {
    speech.stop();
    setState(() {
      listening = false;
    });
  }

  void _showResult(bool correct) {

    stopListening();

    showDialog(
      context: context,
      builder: (_) => AlertDialog(
        title: Text(correct ? "Great Job ⭐" : "Try Again"),
        content: Text(
          correct
              ? "Correct pronunciation!"
              : "Say ${objectNames[currentLetter]} clearly",
        ),
        actions: [
          TextButton(
            child: const Text("Next"),
            onPressed: () {
              Navigator.pop(context);
              _nextLetter();
            },
          )
        ],
      ),
    );
  }

  void _nextLetter() {

    setState(() {

      int next = currentLetter.codeUnitAt(0) + 1;

      if (next > 90) {
        next = 65;
      }

      currentLetter = String.fromCharCode(next);

      spokenText = "";
    });
  }

  @override
  Widget build(BuildContext context) {

    String object = objectNames[currentLetter]!;

    return Scaffold(
      appBar: AppBar(
        title: const Text("AI Pronunciation Trainer"),
      ),

      body: Stack(
        fit: StackFit.expand,
        children: [

          Image.asset(
            'assets/page/learning.png',
            fit: BoxFit.cover,
          ),

          Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [

              Text(
                "$currentLetter for $object",
                style: const TextStyle(
                  fontSize: 34,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 40),

              Image.asset(
                'assets/images/img$currentLetter.png',
                height: 200,
              ),

              const SizedBox(height: 40),

              ElevatedButton.icon(
                onPressed:
                    listening ? stopListening : startListening,
                icon: const Icon(Icons.mic),
                label: Text(
                  listening
                      ? "Listening..."
                      : "Speak $object",
                ),
              ),

              const SizedBox(height: 30),

              Text(
                "You said: $spokenText",
                style: const TextStyle(fontSize: 18),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

