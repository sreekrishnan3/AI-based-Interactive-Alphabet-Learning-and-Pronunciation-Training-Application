/// ================= AI PRONUNCIATION TRAINER ================= ///

class AIPronunciationPage extends StatefulWidget {
  const AIPronunciationPage({super.key});

  @override
  State<AIPronunciationPage> createState() => _AIPronunciationPageState();
}

class _AIPronunciationPageState extends State<AIPronunciationPage> {

  late stt.SpeechToText speech;
  bool listening = false;

  String spokenText = "";
  String currentLetter = "A";

  @override
  void initState() {
    super.initState();
    speech = stt.SpeechToText();
  }

  void startListening() async {

    bool available = await speech.initialize();

    if (available) {

      setState(() {
        listening = true;
      });

      speech.listen(
        onResult: (result) {

          setState(() {
            spokenText = result.recognizedWords.toLowerCase();
          });

          String correctWord =
              objectNames[currentLetter]!.toLowerCase();

          if (spokenText.contains(correctWord)) {
            _showResult(true);
          } else {
            _showResult(false);
          }
        },
      );
    }
  }

  void stopListening() {
    speech.stop();
    setState(() {
      listening = false;
    });
  }

  void _showResult(bool correct) {

    stopListening();

    showDialog(
      context: context,
      builder: (_) => AlertDialog(
        title: Text(correct ? "Great Job ⭐" : "Try Again"),
        content: Text(
          correct
              ? "Correct pronunciation!"
              : "Say ${objectNames[currentLetter]} clearly",
        ),
        actions: [
          TextButton(
            child: const Text("Next"),
            onPressed: () {
              Navigator.pop(context);
              _nextLetter();
            },
          )
        ],
      ),
    );
  }

  void _nextLetter() {

    setState(() {

      int next = currentLetter.codeUnitAt(0) + 1;

      if (next > 90) {
        next = 65;
      }

      currentLetter = String.fromCharCode(next);

      spokenText = "";
    });
  }

  @override
  Widget build(BuildContext context) {

    String object = objectNames[currentLetter]!;

    return Scaffold(
      appBar: AppBar(
        title: const Text("AI Pronunciation Trainer"),
      ),

      body: Stack(
        fit: StackFit.expand,
        children: [

          Image.asset(
            'assets/page/learning.png',
            fit: BoxFit.cover,
          ),

          Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [

              Text(
                "$currentLetter for $object",
                style: const TextStyle(
                  fontSize: 34,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 40),

              Image.asset(
                'assets/images/img$currentLetter.png',
                height: 200,
              ),

              const SizedBox(height: 40),

              ElevatedButton.icon(
                onPressed:
                    listening ? stopListening : startListening,
                icon: const Icon(Icons.mic),
                label: Text(
                  listening
                      ? "Listening..."
                      : "Speak $object",
                ),
              ),

              const SizedBox(height: 30),

              Text(
                "You said: $spokenText",
                style: const TextStyle(fontSize: 18),
              ),
            ],
          ),
        ],
      ),
    );
  }
}     













