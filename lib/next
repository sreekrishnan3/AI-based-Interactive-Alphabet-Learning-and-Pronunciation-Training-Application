                      context,
                      MaterialPageRoute(
                        builder: (_) => MatchAssessmentPage(
                          start: start,
                          end: end,
                        ),
                      ),
                    );
                  }
                },
                child: Image.asset(
                  passed
                      ? 'assets/page/continue.png'
                      : 'assets/page/retry.png',
                  width: 320,
                ),
